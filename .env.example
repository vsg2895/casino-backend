APP_NAME="Casino Affiliate API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=casino_affiliate
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail routing ──────────────────────────────────────────────────────────
# The platform sends two kinds of mail through two transports:
#
#   • ADMIN mail — "Send test" buttons (subscription + verify + promotion) AND
#     real promotion campaigns/scheduler
#       → your own SMTP, configured by the MAIL_* vars below (MAIL_ADMIN_MAILER).
#   • PUBLIC verification mail — when a visitor subscribes on a public site
#       → SendGrid native Web API (NOT SMTP), via SENDGRID_API_KEY (MAIL_PUBLIC_MAILER).
#
# Default mailer used by admin test sends. Set to "smtp" to use the SMTP config
# below; "log" writes to storage/logs for local development.
MAIL_MAILER=log

# SMTP for admin "Send test" emails (your provider: Mailtrap, MailHog, Gmail, …).
# DELIVERABILITY: the sender domain must match the domain your SMTP is authorised
# for, or receivers silently drop the mail (SPF/DKIM/DMARC). Keep MAIL_FROM_ADDRESS
# and SENDGRID_FROM_DOMAIN (the per-site template sender domain) on that SAME domain
# as MAIL_USERNAME. For implicit-TLS providers on port 465, set MAIL_SCHEME=smtps.
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Transport selection (optional — these are the defaults).
MAIL_ADMIN_MAILER=smtp            # admin tests + promotion campaigns → SMTP
MAIL_PUBLIC_MAILER=sendgrid       # public verification emails → SendGrid
MAILGUN_RECEIVER_TEMPLATE_SITE=   # slug whose Promotion Email seeds a Mailgun receiver message
                                  # (empty → the first active site)

# SendGrid — used ONLY for public verification emails (visitor subscribes). Sent
# via the native SendGrid Web API (symfony/sendgrid-mailer) using this key — no
# SMTP. Replace the placeholder with your real key for public emails to deliver.
SENDGRID_API_KEY=SG.fake-key-replace-me-0000000000000000000000
# Advisory only: suggested sending domain shown as a hint in the admin email editor.
SENDGRID_FROM_DOMAIN=example.com

# Forced verified sender for ALL public verification emails, regardless of which
# site the visitor subscribed on. Set to the address on the domain authenticated
# in SendGrid (e.g. noreply@winpalack.com). Display name stays per-site, and the
# email's body links still point at the subscribing site's own real domain.
# Leave EMPTY (once each domain is authenticated) for per-site From domains.
MAIL_PUBLIC_FROM_ADDRESS=noreply@winpalack.com

# Public site URLs baked into email links (verify / unsubscribe). Real https
# domains by default (Site::frontendBaseUrl → https://{site domain}). Uncomment to
# repoint ONE site at a local dev server without affecting the others.
# Ports match each site's real dev port (sites/<slug> PORT), NOT 3000 — the two
# entries here previously named 3000/3001, which pointed idevaffiliation at the
# template's port and winpalack at idevaffiliation's.
#SITE_URL_IDEVAFFILIATION=http://localhost:3001
#SITE_URL_WINPALACK=http://localhost:3002
#SITE_URL_ROULETTINGO=http://localhost:3003
#SITE_URL_VIGLINKSI=http://localhost:3004
#SITE_URL_NONGAMBLES=http://localhost:3005
#SITE_URL_CROGAMBLINE=http://localhost:3006

# Sanctum / CORS — добавьте новые домены сайтов через запятую при расширении
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000
SESSION_DOMAIN=localhost
FRONTEND_URL=http://localhost:5173

# Next.js revalidation — список URL всех публичных сайтов через запятую
# При добавлении нового сайта: добавьте сюда его URL
REVALIDATE_SECRET=
NEXT_REVALIDATE_URLS="http://localhost:3000"

# Admin session length in minutes (180 = 3h). 0 disables expiry.
SANCTUM_TOKEN_EXPIRATION=180

# ── SendGrid Email Address Validation ────────────────────────────────────────
# A SEPARATE key from SENDGRID_API_KEY: the validation endpoint needs the
# "Email Address Validation" permission, which the send key does not have (403).
# Used ONLY by the public subscribe endpoint. A fake or missing key makes the
# subscribe flow fail OPEN — it never blocks a subscription.
SENDGRID_VALIDATION_KEY=SG.replace-me-fake-key-not-real
SENDGRID_VALIDATION_ENABLED=true
# Comma-separated. Default: only Valid earns a verification email.
SENDGRID_VALIDATION_ALLOWED_VERDICTS=Valid
SENDGRID_VALIDATION_MONTHLY_QUOTA=2500
SENDGRID_VALIDATION_TIMEOUT=3
SENDGRID_VALIDATION_CACHE_DAYS=60
SENDGRID_VALIDATION_EMAIL_COOLDOWN=60
# Decision thresholds. Tune these from the admin log's score histogram after a
# month of real data — no code change required.
SENDGRID_VALIDATION_MIN_SCORE=0.7
SENDGRID_VALIDATION_REJECT_ON_KNOWN_BOUNCES=true
SENDGRID_VALIDATION_REJECT_ON_DISPOSABLE=true
SENDGRID_VALIDATION_REJECT_ON_ROLE_ADDRESS=false

# Password-reset email transport. Pinned to SMTP so admin account recovery never
# depends on MAIL_MAILER — unset, that would silently write reset links to the log.
MAIL_PASSWORD_RESET_MAILER=smtp

# ── Admin account seeding (AdminUserSeeder) ──────────────────────────────────
# DESTRUCTIVE: the seeder deletes every user, token and role assignment before
# creating this one login. Never part of a blanket `db:seed`; invoke it by name:
#   php artisan db:seed --class=AdminUserSeeder --force
# No default for the password — the seeder refuses to run without it.
ADMIN_SEED_EMAIL=admin@casino-platform
ADMIN_SEED_PASSWORD=

# Used only by `php artisan news:rewrite`. Without it that command refuses to run.
ANTHROPIC_API_KEY=
