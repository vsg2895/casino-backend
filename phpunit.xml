<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Test-run warnings/errors must never reach storage/logs/laravel.log:
             that file is for real local activity, and test fixtures in it look
             like live sends. -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Address validation is OFF for the suite, and the key is blanked.
             Without these two lines the tests inherit whatever is in the
             developer's .env, and every subscribe test makes a REAL, BILLABLE
             call to SendGrid. That went unnoticed only because the key in .env
             happened to be dead: it 401'd, the gate failed open, and the tests
             passed for the wrong reason. The moment a working key was pasted in,
             three subscribe tests started failing because SendGrid correctly
             judged their made-up addresses undeliverable.
             The email-validation tests enable it per-test via config() and fake
             the HTTP, which is how it should be reached. -->
        <env name="SENDGRID_VALIDATION_ENABLED" value="false"/>
        <env name="SENDGRID_VALIDATION_KEY" value=""/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
